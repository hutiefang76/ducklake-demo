# 将本文件复制为 .env 后填写真实值；.env 已被 Git 忽略，禁止提交真实凭据。
PG_HOST=postgres.example.internal
PG_PORT=5432
PG_DB=ducklake_catalog
PG_USER=ducklake_app
PG_PASSWORD=replace-me

S3_ENDPOINT=http://s3.example.internal:9000
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_USE_SSL=false
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

DUCKLAKE_DATA_PATH=s3://your-ducklake-bucket/path/
DUCKLAKE_ATTACH_NAME=my_lake
DUCKLAKE_PG_CLIENT_ENCODING=UTF8
DUCKDB_PATH=
DUCKDB_EXTENSION_DIRECTORY=
DUCKLAKE_INSTALL_EXTENSIONS=true
