# 将本文件复制为 .env 后填写真实值；.env 已被 Git 忽略，禁止提交真实凭据。
PG_HOST=postgres.example.internal
PG_PORT=5432
PG_DB=ducklake_catalog
PG_USER=ducklake_app
PG_PASSWORD=replace-me

S3_ENDPOINT=http://s3.example.internal:9000
S3_REGION=us-east-1
S3_URL_STYLE=path
S3_USE_SSL=false
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

DUCKLAKE_DATA_PATH=s3://your-ducklake-bucket/path/
DUCKLAKE_ATTACH_NAME=my_lake
DUCKLAKE_METADATA_SCHEMA=ducklake_catalog
DUCKLAKE_PG_CLIENT_ENCODING=UTF8
DUCKDB_PATH=
DUCKDB_EXTENSION_DIRECTORY=
DUCKLAKE_INSTALL_EXTENSIONS=true

# DolphinScheduler 逻辑目录由转换平台生成，禁止在应用中硬编码 numeric code。
DS_ENABLED=false
DS_BASE_URL=http://dolphinscheduler-api:12345/dolphinscheduler
DS_TOKEN=replace-me
ETL_SCHEDULER_CATALOG_PATH=C:/secure/etl-scheduler-catalog.json

# ETL 文件上传与运行台账。生产环境通过 Kubernetes Secret 注入。
ETL_PLATFORM_ENABLED=false
ETL_ARTIFACT_S3_ENDPOINT=http://s3.example.internal:8333
ETL_ARTIFACT_S3_REGION=us-east-1
ETL_ARTIFACT_S3_ACCESS_KEY=replace-me
ETL_ARTIFACT_S3_SECRET_KEY=replace-me
ETL_ARTIFACT_S3_BUCKET=dp-springboot-files
ETL_ARTIFACT_S3_PREFIX=data-platform-dev/etl-platform
ETL_ARTIFACT_MAX_BYTES=536870912
ETL_LEDGER_JDBC_URL=jdbc:postgresql://postgres.example.internal:5432/dp_etl_control
ETL_LEDGER_USERNAME=etl_app
ETL_LEDGER_PASSWORD=replace-me
ETL_LEDGER_SCHEMA=etl_control

# 业务 API 到逻辑 Workflow 的映射可配置；默认值对应首条物料 DAG。
ETL_MATERIAL_PROJECT_ID=notebooks-etl
ETL_MATERIAL_WORKFLOW_ID=material.master_refresh
